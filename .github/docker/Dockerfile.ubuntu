ARG VERSION="24.04"
FROM ubuntu:${VERSION}

ARG LLVM_VERSION="18"
ENV LLVM_VERSION=$LLVM_VERSION

ARG SHORTNAME="noble"
ENV SHORTNAME=$SHORTNAME

ARG DEBIAN_FRONTEND="noninteractive"
ENV TZ="Etc/UTC"

RUN apt-get update && apt-get install -y ca-certificates curl gnupg

# The current development version is only available from the snapshot suite.
RUN mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://apt.llvm.org/llvm-snapshot.gpg.key \
      | gpg --dearmor -o /etc/apt/keyrings/llvm.gpg && \
    if [ "${LLVM_VERSION}" = "24" ]; then \
        SUITE="llvm-toolchain-${SHORTNAME}"; \
    else \
        SUITE="llvm-toolchain-${SHORTNAME}-${LLVM_VERSION}"; \
    fi && \
    echo "deb [signed-by=/etc/apt/keyrings/llvm.gpg] http://apt.llvm.org/${SHORTNAME}/ ${SUITE} main" \
      > /etc/apt/sources.list.d/llvm.list

RUN apt-get update && apt-get install -y \
      libelf-dev \
      zlib1g-dev \
      libbfd-dev \
      gcc \
      clang-${LLVM_VERSION} \
      libclang-${LLVM_VERSION}-dev \
      libclang-common-${LLVM_VERSION}-dev \
      llvm-${LLVM_VERSION} \
      llvm-${LLVM_VERSION}-dev \
      llvm-${LLVM_VERSION}-runtime \
      make pkg-config \
      sudo \
      && apt-get -y clean

RUN ln -s /usr/bin/clang-${LLVM_VERSION} /usr/bin/clang && ln -s /usr/bin/llvm-strip-${LLVM_VERSION} /usr/bin/llvm-strip
